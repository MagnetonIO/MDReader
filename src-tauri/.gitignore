# Cargo build artifacts (the workspace root also ignores `target/`).
/target/

# Tauri-generated capability schemas (autocomplete only, regenerated by build).
/gen/schemas

# Ephemeral, exact-commit handoff used by nested Tauri mobile builds. The
# native harness creates it with exclusive ownership and removes it afterward.
/.e2e-source-commit

# Exclusive clean-HEAD handoff for nested Xcode/Gradle release-source stamping.
/.release-source-commit
