{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDReader",
  "identifier": "dev.mdreader.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @mdreader/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @mdreader/app build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDReader",
        "width": 1120,
        "height": 680,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Magneton Labs, LLC (7727LYTG96)"
    }
  }
}
