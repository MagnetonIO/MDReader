{
  "name": "@mdreader/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:shared && vite",
    "build": "pnpm run build:shared && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:settings-browser": "playwright test --config playwright.settings.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tauri": "node ../scripts/development/tauri.mjs",
    "build:shared": "pnpm --filter @mdreader/config build && pnpm --filter @mdreader/markdown build && pnpm --filter @mdreader/ui build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@mdreader/markdown": "workspace:*",
    "@mdreader/ui": "workspace:*",
    "@tanstack/react-virtual": "^3.14.7",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "cmdk": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@mdreader/config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
