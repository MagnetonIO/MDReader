{
  "extends": "@mdreader/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  // `e2e` is in scope too: the Playwright specs are the only automated proof of
  // several surfaces, and a spec that does not typecheck is a spec that can rot
  // silently (the runner transpiles without checking).
  "include": ["src", "e2e", "playwright.config.ts"]
}
