# Copy to .env.local (ignored). Native registration configuration only.
# Existing .env names remain supported; never add user access/refresh tokens.
# pnpm tauri dev reads the main checkout and then this worktree's overrides.
MDREADER_GOOGLE_DRIVE_CLIENT_ID=
# Some Google Desktop registrations require this parameter, including with PKCE.
# Native-only; never use a VITE_ name or commit the actual value.
# MDREADER_GOOGLE_DRIVE_CLIENT_SECRET=
MDREADER_DROPBOX_CLIENT_ID=
MDREADER_DROPBOX_REDIRECT_URI=http://127.0.0.1:53682/oauth/dropbox
# Optional explicit native names override the corresponding names above.
# MDREADER_NATIVE_DRIVE_CLIENT_ID=
# MDREADER_NATIVE_DRIVE_CLIENT_SECRET=
# MDREADER_NATIVE_DROPBOX_CLIENT_ID=
# MDREADER_NATIVE_DROPBOX_REDIRECT_URI=
# selected_folder supports fresh consent with an explicitly chosen Dropbox path.
# App Folder registrations may instead retain their reviewed metadata contract.
# MDREADER_NATIVE_DROPBOX_ACCESS_TYPE=selected_folder
# MDREADER_NATIVE_DROPBOX_APP_FOLDER_REGISTRATION_SHA256=

# Existing public development account registration (no secrets):
# pnpm tauri dev --sync-development
# pnpm tauri build --debug --sync-development
# An explicit disabled stage overrides that preset.
# MDREADER_NATIVE_SYNC_STAGE=disabled

# Mobile uses the same reviewed Auth0 issuer/client/endpoints as desktop.
# Register this exact callback before enabling the optional mobile adapter.
# MDREADER_MOBILE_SYNC_REDIRECT_URI=dev.mdreader.app.auth://callback/mdreader-sync
