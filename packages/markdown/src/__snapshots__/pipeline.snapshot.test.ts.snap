exports[`parseMarkdown hast snapshots > docs/reference/no-headings.md renders stable hast 1`] = `
"<p data-line-start="6" data-line-end="7">This file has frontmatter but not a single markdown heading. It is all body
text, the kind you get from an exported clipping or a plain paragraph note.</p>
<p data-line-start="9" data-line-end="9">It still has structure of a sort: a couple of paragraphs, a list, and a link.</p>
<ul data-line-start="11" data-line-end="13">
<li>one</li>
<li>two</li>
<li>three</li>
</ul>
<p data-line-start="15" data-line-end="17">The outline builder should produce an empty heading tree here and fall back to
the frontmatter <code>title</code>. Related reading: the
<a href="headings-deep.md">deep headings</a> example.</p>"
`;

exports[`parseMarkdown hast snapshots > edge-cases/crlf-endings.md renders stable hast 1`] = `
"<h1 id="user-content-crlf-endings" data-line-start="6" data-line-end="6">CRLF Endings</h1>
<p data-line-start="8" data-line-end="10">Every line in this file ends with a carriage-return + line-feed (\\r\\n), the
Windows convention. Parsers and offset trackers must normalize these so that
headings, lists, and links still resolve.</p>
<ul data-line-start="12" data-line-end="14">
<li>first</li>
<li>second</li>
<li>third</li>
</ul>
<p data-line-start="16" data-line-end="16">A link back to the <a href="../index.md">index</a> to keep it in the link web.</p>"
`;

exports[`parseMarkdown hast snapshots > edge-cases/unclosed-fence.md renders stable hast 1`] = `
"<h1 id="user-content-unclosed-fence" data-line-start="6" data-line-end="6">Unclosed Fence</h1>
<p data-line-start="8" data-line-end="10">The paragraph before the fence is normal. Below, a code fence opens and is never
closed — the rest of the file should be treated as code until EOF, and the
parser must not hang or crash.</p>
<pre data-line-start="12" data-line-end="18"><code class="language-rust">fn main() {
    println!("this fence is never closed");
    // no closing backticks follow — EOF ends the block
    let x = 1;
    let y = 2;
</code></pre>"
`;

exports[`parseMarkdown hast snapshots > edge-cases/unicode-emoji-cjk.md renders stable hast 1`] = `
"<h1 id="user-content-unicode--表意文字-テスト" data-line-start="6" data-line-end="6">Unicode 🌍 表意文字 テスト</h1>
<p data-line-start="8" data-line-end="8">Mixed scripts in one heading and one body.</p>
<h2 id="user-content-emoji" data-line-start="10" data-line-end="10">Emoji</h2>
<p data-line-start="12" data-line-end="13">Status: ✅ done, 🚧 in progress, ❌ blocked. Family: 👩‍👩‍👧‍👦 (a ZWJ sequence that
is one grapheme but several code points). Flags: 🇯🇵 🇰🇷 🇺🇸. Skin tone: 👍🏽.</p>
<h2 id="user-content-cjk" data-line-start="15" data-line-end="15">CJK</h2>
<ul data-line-start="17" data-line-end="19">
<li>中文：知识库把文档变成向量。</li>
<li>日本語：ドキュメントをベクトルに変換します。</li>
<li>한국어: 문서를 벡터로 변환합니다.</li>
</ul>
<h2 id="user-content-diacritics-and-rtl" data-line-start="21" data-line-end="21">Diacritics and RTL</h2>
<p data-line-start="23" data-line-end="23">Café, naïve, Zürich, Håkon, Þorvaldur. Arabic: مرحبا بالعالم. Hebrew: שלום עולם.</p>
<h2 id="user-content-widths-and-combining-marks" data-line-start="25" data-line-end="25">Widths and combining marks</h2>
<p data-line-start="27" data-line-end="27">Full-width ＡＢＣ next to ASCII ABC. Combining: e + ́ = é. Zalgo-lite: a̐b̽c̈.</p>
<p data-line-start="29" data-line-end="30">Character counts here are a good test for byte-vs-grapheme offset handling in
<a href="../notes/zettel/node-provenance.md">provenance</a>.</p>"
`;

