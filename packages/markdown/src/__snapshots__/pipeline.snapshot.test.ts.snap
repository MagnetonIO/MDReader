exports[`parseMarkdown hast snapshots > notes/zettel/wikilinks.md renders stable hast 1`] = `
"<h1 id="user-content-wiki-link-syntax" data-line-start="6" data-line-end="6">Wiki-link Syntax</h1>
<p data-line-start="8" data-line-end="8">A plain link to another note: <wiki-link class="wikilink" data-wikilink="true" data-target="node-storage">node-storage</wiki-link>.</p>
<p data-line-start="10" data-line-end="10">A link with a label: <wiki-link class="wikilink" data-wikilink="true" data-target="node-query-engine" data-label="the query engine">the query engine</wiki-link>.</p>
<p data-line-start="12" data-line-end="12">A link to a heading inside a note: <wiki-link class="wikilink" data-wikilink="true" data-target="node-search" data-heading="Search">node-search#Search</wiki-link>.</p>
<p data-line-start="14" data-line-end="15">A link to a heading with a custom label:
<wiki-link class="wikilink" data-wikilink="true" data-target="node-embeddings" data-heading="Embeddings" data-label="how vectors work">how vectors work</wiki-link>.</p>
<p data-line-start="17" data-line-end="18">Links can sit inline in a sentence — see <wiki-link class="wikilink" data-wikilink="true" data-target="graph-hub">graph-hub</wiki-link> for the whole web — or
stacked in a list:</p>
<ul data-line-start="20" data-line-end="22">
<li><wiki-link class="wikilink" data-wikilink="true" data-target="node-ingest">node-ingest</wiki-link></li>
<li><wiki-link class="wikilink" data-wikilink="true" data-target="node-provenance">node-provenance</wiki-link></li>
<li><wiki-link class="wikilink" data-wikilink="true" data-target="node-graph-view">node-graph-view</wiki-link></li>
</ul>
<p data-line-start="24" data-line-end="24">Contrast these with the deliberately <wiki-link class="wikilink" data-wikilink="true" data-target="broken-links" data-label="broken ones">broken ones</wiki-link>.</p>"
`;
