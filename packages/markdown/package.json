{
  "name": "@mdreader/markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-client.d.ts",
      "default": "./dist/worker-client.js"
    },
    "./worker-conditions": {
      "types": "./dist/worker-resolve-conditions.d.ts",
      "default": "./dist/worker-resolve-conditions.js"
    },
    "./katex.css": "./katex.css"
  },
  "files": [
    "dist",
    "katex.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "gen:parity-reference": "vitest run --config vitest.gen.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mdreader/config": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/unist": "^3.0.3",
    "eslint": "^9.39.5",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "^29.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "micromark-util-types": "^2.0.2",
    "typescript": "~6.0.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "katex": "^0.18.1",
    "micromark-util-character": "^2.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
