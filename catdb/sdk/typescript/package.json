{
  "name": "@catdb/client",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Typed TypeScript SDK for the CatDB platform HTTP API. Types are generated from the committed OpenAPI (catdb/proto/openapi.json).",
  "license": "Apache-2.0 OR MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read-only": {
      "types": "./dist/read-only.d.ts",
      "default": "./dist/read-only.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "openapi-typescript ../../proto/openapi.json -o src/openapi.gen.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
