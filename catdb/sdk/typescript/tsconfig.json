{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Self-contained compiler settings, mirrored from packages/config/tsconfig.base.json. This is a PLATFORM package and must not depend on the @mdreader/* (packages/**) tooling; the strictness is kept in lockstep by hand.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"]
}
