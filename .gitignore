# Superpowers workspace metadata
.superpowers/

# Rust
target/
/target
**/*.rs.bk

# Node / frontend (Tauri + Next side, scaffolded by later tasks)
node_modules/
dist/
.next/
.wrangler/
.vercel/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Ladle story dev-server / build output (@mdreader/ui stories)
build/
