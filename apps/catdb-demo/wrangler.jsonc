{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "catdb-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "containers": [
    {
      "class_name": "CatDbDemoContainer",
      "image": "../../Dockerfile.catdb-demo",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CATDB_DEMO",
        "class_name": "CatDbDemoContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CatDbDemoContainer"]
    }
  ],
  "env": {
    "staging": {
      "name": "catdb-demo-staging",
      "workers_dev": true,
      "containers": [
        {
          "class_name": "CatDbDemoContainer",
          "image": "../../Dockerfile.catdb-demo",
          "instance_type": "lite",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "CATDB_DEMO",
            "class_name": "CatDbDemoContainer"
          }
        ]
      }
    }
  }
}
