{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "webdriverio", "@wdio/globals/types", "@wdio/mocha-framework", "expect-webdriverio"]
  },
  "include": [
    "flows.ts",
    "bundle.ts",
    "seed.ts",
    "*.test.ts",
    "capabilities.ts",
    "validate-artifact.ts",
    "drivers/**/*.ts",
    "runners/**/*.ts",
    "config/**/*.ts",
    "specs/**/*.ts"
  ]
}
